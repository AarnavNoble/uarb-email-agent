# Copy to .env and fill in. .env is gitignored; never commit real values.
# fetch, parse, simulate, search and the tests need none of this.

# --- Required to serve email ------------------------------------------------------------------------------
# Dedicated Gmail inbox the agent reads and replies from.
AGENT_EMAIL=
# Gmail app password (needs 2-Step Verification on the account).
AGENT_APP_PASSWORD=
# Where operator notices go (e.g. the Gmail API sign-in reminder).
OWNER_EMAIL=

# --- Sending through the Gmail API (for hosts that block SMTP) ----------------------------------------------
# Written by scripts/gmail_auth.py; when present they replace SMTP for outgoing mail.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_TOKEN_ISSUED=

# --- Optional -----------------------------------------------------------------------------------------------
# Claude Haiku interprets wording the rules can't. Off unless true and a key is set.
LLM_ENABLED=false
ANTHROPIC_API_KEY=
# Public HTTPS base for download links to files too large to email (Caddy serves data/links at /d/).
PUBLIC_BASE_URL=
# LINK_TTL_DAYS=7
# healthchecks.io ping URL: a heartbeat while the inbox loop is healthy, /fail when a send fails.
HEALTHCHECK_URL=
# Self-sent mail carrying this value in X-Agent-Canary is answered (scripts/send_tests.py).
CANARY_TOKEN=

# Overrides (defaults in uarb_agent/config.py).
# DATA_DIR=data
# MAX_DOCS=10
# ZIP_BUDGET_MB=16
# UARB_URL=https://uarb.novascotia.ca/fmi/webd/UARB15
# UARB_CONCURRENCY=2
# UARB_SESSION_GAP_S=2.0
