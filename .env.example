# Copy to .env and fill in. .env is gitignored; never commit real values.

# Dedicated Gmail inbox the agent reads and replies from.
AGENT_EMAIL=
# Gmail app password (needs 2-Step Verification on the account).
AGENT_APP_PASSWORD=
# Where operator alerts go (failures, layout changes).
OWNER_EMAIL=

# Optional Haiku fallback parser. Off unless LLM_ENABLED=true and a key is set.
LLM_ENABLED=false
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown in uarb_agent/config.py).
# DATA_DIR=data
# MAX_DOCS=10
# ZIP_BUDGET_MB=16
# UARB_URL=https://uarb.novascotia.ca/fmi/webd/UARB15
# UARB_CONCURRENCY=2

# Optional healthchecks.io ping URL; the agent pings it while the inbox loop is healthy.
# HEALTHCHECK_URL=

# Self-sent test mail carrying this in X-Agent-Canary is answered (see scripts/send_tests.py).
CANARY_TOKEN=
# Set by scripts/gmail_auth.py when sending through the Gmail API.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_TOKEN_ISSUED=
# healthchecks.io ping URL; emails the owner when the agent stops or a send fails.
HEALTHCHECK_URL=
