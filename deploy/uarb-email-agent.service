# systemd unit for a Linux host.
#   sudo cp deploy/uarb-email-agent.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now uarb-email-agent
#   journalctl -u uarb-email-agent -f
[Unit]
Description=UARB email agent
Wants=network-online.target
After=network-online.target

[Service]
User=agent
WorkingDirectory=/home/agent/uarb-email-agent
ExecStart=/home/agent/uarb-email-agent/.venv/bin/uarb-agent serve
Restart=always
RestartSec=10
# Chromium children belong to the service; stop them with it. In-flight replies get time to finish.
KillMode=control-group
TimeoutStopSec=75
MemoryMax=1500M

[Install]
WantedBy=multi-user.target
